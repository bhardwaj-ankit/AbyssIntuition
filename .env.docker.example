# Public domain for HTTPS with Caddy.
# Example: api.example.com
# Keep as localhost if you are only testing locally.
API_DOMAIN=localhost

# Email used by Caddy/Let's Encrypt for certificate notices.
ACME_EMAIL=you@example.com

# Optional. When set, all API endpoints except /, /health, docs, and /static
# require either:
# Authorization: Bearer <token>
# or
# X-API-Token: <token>
API_ACCESS_TOKEN=replace-with-a-long-random-secret

# Optional Bybit demo env overrides.
BYBIT_DEMO_BASE_URL=https://api-demo.bybit.com
BYBIT_DEMO_CATEGORY=linear
BYBIT_DEMO_ACCOUNT_TYPE=UNIFIED
